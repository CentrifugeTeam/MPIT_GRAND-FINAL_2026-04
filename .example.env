# JWT настройки
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lessons_service
DB_HOST=postgres-db

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_HOST=rabbitmq

# SMTP настройки (для уведомлений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# CloudPub
CLOUDPUB_TOKEN=your-cloudpub-token

# Количество реплик
NUMBER_OF_REPLICAS=2

# режим работы серверной части
BACKEND_LOCAL=True

# Analytics NL→SQL (прокси в BFF)
ANALYTICS_SERVICE_URL=http://analytics-service:8009

# LLM (OpenAI-compatible /chat/completions): analytics-service, sql-generator-worker, nl-orchestrator-worker
# Один набор переменных для всех трёх сервисов в docker-compose.
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
# OpenAI: gpt-4o, gpt-4o-mini | Groq: https://api.groq.com/openai/v1 + ключ Groq → llama-3.3-70b-versatile, llama-3.1-70b-versatile, mixtral-8x7b-32768
# Self-host (Ollama): LLM_BASE_URL=http://host.docker.internal:11434/v1 LLM_API_KEY=ollama LLM_MODEL=llama3.1:8b
# vLLM/text-generation-inference: тот же формат base .../v1 и имя модели из сервера
LLM_MODEL=gpt-4o-mini
# OpenRouter (платн. reasoning): true — в запрос добавляется reasoning: { "enabled": true } и в ответ читаем нативные поля
# LLM_NATIVE_REASONING=true
# true — /chat/completions с stream, reasoning в WebSocket чанками (chat_thinking)
# LLM_STREAM_REASONING=true

# sql-generator-worker: LLM до SQL (анализ вопроса по схеме). Пустая модель = выключено.
# Ключ/URL не заданы — берутся из LLM_*.
# ORCHESTRATOR_LLM_MODEL=llama-3.1-8b-instant
# ORCHESTRATOR_LLM_BASE_URL=https://api.groq.com/openai/v1

# sql-generator-worker: LLM после выполнения SQL (краткий ответ + отчёт). Пустая модель = выключено.
# REPORTER_LLM_MODEL=llama-3.1-8b-instant
# REPORTER_MAX_ROWS_IN_CONTEXT=40
# REPORTER_MAX_JSON_CHARS=24000

# NL-оркестратор (nl-orchestrator-worker), те же LLM_*
# CHAT_MAX_HISTORY_MESSAGES=20
# Лимит строк для SQL в чате (оркестратор → воркер max_rows)
# CHAT_SQL_MAX_ROWS=10000

# main-db-bootstrap: DDL + CSV в main_db (лимит = порог skip при повторном up)
# CSV_SEED_LIMIT=1000
# MAIN_DB_SEED_DSN=postgresql://postgres:postgres@main-db:5432/main_db
# MAIN_DB_CSV_PATH=/work/dataset/train.csv

# Платформа NL→SQL (таблицы nl_sql_jobs, nl_chat_*, analytics_data_sources).
# Это НЕ «БД с ответами графиков» — только метаданные и реестр источников.
# URL-ы реальных данных для SELECT задаются источниками (см. ниже) — в docker-compose у analytics-service.
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@postgres-db:5432/postgres-db
SCHEMA_CRON_HOUR=3

# Источники NL = те же Postgres, что в docker-compose (main-db → main_db, postgres-db → postgres-db).
# В Docker-сети хосты: main-db:5432 и postgres-db:5432. С хоста машины: localhost:5447 и localhost:5446.
DEFAULT_ANALYTICS_SOURCE_KEY=main-db
# Третий сегмент после URL (опционально) — подпись в UI: key|url|label||...
ANALYTICS_SOURCES_INLINE=main-db|postgresql://postgres:postgres@main-db:5432/main_db|Warehouse (main_db)||postgres-main|postgresql://postgres:postgres@postgres-db:5432/postgres-db|Platform (internal)
# Один URL на случай, если таблица источников ещё пуста (совпадает с дефолтным источником main-db)
ANALYTICS_DATABASE_URL=postgresql://postgres:postgres@main-db:5432/main_db
# BFF в WebSocket использует тот же DEFAULT_ANALYTICS_SOURCE_KEY (см. docker-compose bff-service), если клиент не прислал analytics_source_key.
# Ключи через запятую: для chat_message принудительно подменяются на DEFAULT (по умолчанию platform не для NL-витрины).
# NL_CHAT_BLOCKED_SOURCE_KEYS=postgres-main
# Пусто = CRUD источников без токена (dev). В проде задайте одинаковое значение в analytics-service и bff-service.
ANALYTICS_SOURCES_WRITE_TOKEN=

# --- Guardrails (роли, политики, лимиты, аудит) ---
# BFF: Redis для rate limit (пусто = без лимита). В docker-compose по умолчанию redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120

# Жёсткий верх строк в SELECT / LIMIT (analytics-service, sql-generator-worker; оркестратор — ORCH_GLOBAL_MAX_ROWS)
GLOBAL_MAX_ROWS=100000
ORCH_GLOBAL_MAX_ROWS=100000
MAX_SQL_TEXT_BYTES=256000

# sql-generator-worker: оценка планировщика PostgreSQL (0 = не проверять)
MAX_PLANNER_TOTAL_COST=0
EXPLAIN_TIMEOUT_MS=5000
QUERY_AUDIT_ENABLED=true

# nl-orchestrator-worker: при confidence ниже порога — уточняющее сообщение без SQL
INTERPRET_CONFIDENCE_THRESHOLD=0.45
