# JWT настройки
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lessons_service
DB_HOST=postgres-db

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_HOST=rabbitmq

# SMTP настройки (для уведомлений)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# CloudPub
CLOUDPUB_TOKEN=your-cloudpub-token

# Количество реплик
NUMBER_OF_REPLICAS=2

# режим работы серверной части
BACKEND_LOCAL=True

# Analytics NL→SQL (прокси в BFF)
ANALYTICS_SERVICE_URL=http://analytics-service:8009

# LLM (OpenAI-compatible API), для analytics-service
LLM_API_KEY=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
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# sql-generator-worker: LLM до SQL (анализ вопроса по схеме). Пустая модель = выключено.
# Ключ/URL не заданы — берутся из LLM_*.
# ORCHESTRATOR_LLM_MODEL=llama-3.1-8b-instant
# ORCHESTRATOR_LLM_BASE_URL=https://api.groq.com/openai/v1

# sql-generator-worker: LLM после выполнения SQL (краткий ответ + отчёт). Пустая модель = выключено.
# REPORTER_LLM_MODEL=llama-3.1-8b-instant
# REPORTER_MAX_ROWS_IN_CONTEXT=40
# REPORTER_MAX_JSON_CHARS=24000

# NL-оркестратор (отдельный контейнер nl-orchestrator-worker), те же LLM_* что и для воркера SQL
# CHAT_MAX_HISTORY_MESSAGES=20
# CHAT_SQL_MAX_ROWS=5000

# Платформа NL→SQL (таблицы nl_sql_jobs, nl_chat_*, analytics_data_sources).
# Это НЕ «БД с ответами графиков» — только метаданные и реестр источников.
# URL-ы реальных данных для SELECT задаются источниками (см. ниже) — в docker-compose у analytics-service.
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@postgres-db:5432/postgres-db
SCHEMA_CRON_HOUR=3

# Источники NL = те же Postgres, что в docker-compose (postgres-files → files_db, postgres-db → postgres-db).
# В Docker-сети хосты: postgres-files:5432 и postgres-db:5432. С хоста машины: localhost:5447 и localhost:5446.
DEFAULT_ANALYTICS_SOURCE_KEY=files-db
ANALYTICS_SOURCES_INLINE=files-db|postgresql://postgres:postgres@postgres-files:5432/files_db||postgres-main|postgresql://postgres:postgres@postgres-db:5432/postgres-db
# Один URL на случай, если таблица источников ещё пуста (совпадает с дефолтным источником files-db)
ANALYTICS_DATABASE_URL=postgresql://postgres:postgres@postgres-files:5432/files_db
# Пусто = CRUD источников без токена (dev). В проде задайте одинаковое значение в analytics-service и bff-service.
ANALYTICS_SOURCES_WRITE_TOKEN=
